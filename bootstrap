#!/usr/bin/env bash

set -euo pipefail

if [[ $EUID -eq 0 ]]; then
  echo 'Run bootstrap as your normal user, not with sudo.' >&2
  exit 1
fi

checkout=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ ! -f "$checkout/.chezmoiroot" ]]; then
  checkout="$HOME/src/aaronmallen.dev/aaron/dotfiles"
fi
if [[ -e "$checkout" && ! -f "$checkout/.chezmoiroot" ]]; then
  echo "Refusing to replace existing directory: $checkout" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export PATH="$HOME/.local/bin:$PATH"

case "$(uname -s)" in
Darwin)
  if ! command -v brew >/dev/null; then
    for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [[ -x "$brew" ]]; then
        eval "$("$brew" shellenv bash)"
        break
      fi
    done
  fi
  if ! command -v brew >/dev/null; then
    curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$work/homebrew"
    bash "$work/homebrew"
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv bash)"
    else
      eval "$(/usr/local/bin/brew shellenv bash)"
    fi
  fi
  brew install git gnupg zsh mise chezmoi jq
  if ! command -v op >/dev/null; then
    brew install --cask 1password-cli
  fi
  ;;
Linux)
  if command -v apt-get >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y ca-certificates curl git gnupg zsh unzip build-essential jq
    if ! command -v op >/dev/null; then
      curl -fsSL https://downloads.1password.com/linux/keys/1password.asc -o "$work/1password.asc"
      gpg --batch --yes --dearmor --output "$work/1password.gpg" "$work/1password.asc"
      sudo install -m 644 "$work/1password.gpg" /usr/share/keyrings/1password-archive-keyring.gpg
      printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' \
        "$(dpkg --print-architecture)" "$(dpkg --print-architecture)" >"$work/1password.list"
      sudo install -m 644 "$work/1password.list" /etc/apt/sources.list.d/1password.list
      curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol -o "$work/1password.pol"
      sudo install -d /etc/debsig/policies/AC2D62742012EA22 /usr/share/debsig/keyrings/AC2D62742012EA22
      sudo install -m 644 "$work/1password.pol" /etc/debsig/policies/AC2D62742012EA22/1password.pol
      sudo install -m 644 "$work/1password.gpg" /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
      sudo apt-get update
      sudo apt-get install -y 1password-cli
    fi
  elif command -v pacman >/dev/null; then
    sudo pacman -Syu --needed --noconfirm base-devel ca-certificates curl git gnupg zsh unzip jq
    if command -v paru >/dev/null; then
      aur=paru
    elif command -v yay >/dev/null; then
      aur=yay
    else
      git clone https://aur.archlinux.org/yay.git "$work/yay"
      (cd "$work/yay" && makepkg -si --noconfirm)
      aur=yay
    fi
    if ! command -v op >/dev/null; then
      "$aur" -S --needed 1password-cli
    fi
  else
    echo 'Supported Linux distributions use APT or pacman.' >&2
    exit 1
  fi
  if ! command -v mise >/dev/null; then
    curl -fsSL https://mise.run -o "$work/mise"
    sh "$work/mise"
  fi
  ;;
*)
  echo 'Bootstrap supports macOS, Debian/Ubuntu, and Arch/CachyOS.' >&2
  exit 1
  ;;
esac

if ! command -v chezmoi >/dev/null; then
  cd "$HOME"
  mise_env=$(mise env --shell bash chezmoi@latest)
  eval "$mise_env"
fi

if [[ ! -f "$checkout/.chezmoiroot" ]]; then
  mkdir -p "$(dirname "$checkout")"
  git clone https://aaronmallen.dev/aaron/dotfiles.git "$checkout"
fi

cd "$checkout"
chezmoi init --source "$checkout"

manager=$(chezmoi execute-template '{{ .packageManager }}')
case "$manager" in
brew | paru | yay)
  if ! command -v "$manager" >/dev/null; then
    echo "Selected package manager $manager is not installed. Run chezmoi init and choose the installed manager." >&2
    exit 1
  fi
  ;;
esac

if [[ $(chezmoi execute-template '{{ .profile }}') == personal ||
$(chezmoi execute-template '{{ .email }}') == hello@aaronmallen.me ]]; then
  if ! op whoami >/dev/null 2>&1; then
    echo 'Sign in to 1Password. For a new CLI account, enter its address, email, and Secret Key when prompted.'
    if ! session=$(op signin --raw); then
      session=$(op account add --signin --raw)
    fi
    export OP_SESSION="$session"
    op whoami >/dev/null
  fi
fi

chezmoi apply --source "$checkout"
