{{- $packages := dict -}}
{{- range $name, $package := .packages -}}
{{-   if not (get $package "profiles") -}}{{- fail (printf "package %s needs a non-empty profiles list" $name) -}}{{- end -}}
{{-   if not (or (has "default" $package.profiles) (has $.profile $package.profiles)) -}}{{- continue -}}{{- end -}}
{{-   if and (hasKey $package "platforms") (not (has $.chezmoi.os $package.platforms)) -}}{{- continue -}}{{- end -}}
{{-   $_ := set $packages $name $package -}}
{{- end -}}
{{- $packages | toJson -}}
