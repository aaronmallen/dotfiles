{{- $lines := list -}}
{{- range (includeTemplate "packages" . | fromJson) -}}
{{-   with get . "apt" -}}
{{-     if kindIs "map" . -}}
{{-       if ne (dig "id" "" $.chezmoi.osRelease) .distro -}}{{- continue -}}{{- end -}}
{{-       if lt (float64 (dig "versionID" "0" $.chezmoi.osRelease)) (float64 .min_version) -}}{{- continue -}}{{- end -}}
{{-       $lines = append $lines .name -}}
{{-     else -}}
{{-       $lines = append $lines . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ join "\n" (sortAlpha $lines) }}
