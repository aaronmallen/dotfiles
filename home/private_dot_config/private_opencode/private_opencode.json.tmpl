{{- $servers := dict -}}
{{- range $name, $server := .ai.mcp_servers -}}
{{-   if hasKey $server "url" -}}
{{-     $remote := dict "type" "remote" "url" $server.url -}}
{{-     $headers := dict -}}
{{-     with get $server "bearer_token_env_var" -}}{{- $_ := set $headers "Authorization" (printf "Bearer {env:%s}" .) -}}{{- end -}}
{{-     range $header, $var := dig "header_env_vars" dict $server -}}{{- $_ := set $headers $header (printf "{env:%s}" $var) -}}{{- end -}}
{{-     if $headers -}}
{{-       $_ := set $remote "oauth" false -}}
{{-       $_ := set $remote "headers" $headers -}}
{{-     end -}}
{{-     with get $server "oauth_client_id" -}}{{- $_ := set $remote "oauth" (dict "clientId" .) -}}{{- end -}}
{{-     $_ := set $servers $name $remote -}}
{{-   else -}}
{{-     $_ := set $servers $name (dict "type" "local" "command" (concat $server.command (dig "args" "opencode" list $server))) -}}
{{-   end -}}
{{- end -}}
{{- $plugins := list -}}
{{- range .ai.plugins -}}
{{-   if hasKey . "opencode" -}}
{{-     $plugins = append $plugins .opencode -}}
{{-   end -}}
{{- end -}}
{{- dict "mcp" (dict "servers" $servers) "permission" (dict "*" "allow") "plugins" $plugins | toPrettyJson }}
