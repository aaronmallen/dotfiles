{{- $lines := list -}}
{{- range (includeTemplate "packages" . | fromJson) -}}
{{-   with get . "brew" -}}
{{-     $kind := "brew" -}}
{{-     $name := get . "formula" | default (get . "cask") -}}
{{-     if hasKey . "cask" -}}{{- $kind = "cask" -}}{{- end -}}
{{-     $line := printf "%s %s" $kind ($name | quote) -}}
{{-     if get . "trusted" -}}{{- $line = printf "%s, trusted: true" $line -}}{{- end -}}
{{-     $lines = append $lines $line -}}
{{-   end -}}
{{-   with get . "mas" -}}
{{-     $lines = append $lines (printf "mas %s, id: %d" (.name | quote) (.id | int)) -}}
{{-   end -}}
{{- end -}}
{{ join "\n" (sortAlpha $lines) }}
