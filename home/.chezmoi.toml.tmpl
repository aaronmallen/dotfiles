{{- $email := promptStringOnce . "email" "What is your email address?" -}}
{{- $fullName := promptStringOnce . "fullName" "What is your full name?" -}}

{{- $packageManager := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $packageManager = "brew" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $packageManagers := list "apt" "brew" "paru" "yay" -}}
{{-   $packageManager = promptChoiceOnce . "packageManager" "Which package manager should be used?" $packageManagers -}}
{{- end -}}

{{- $profiles := list "app" "dev" "personal" "rnr" "work" -}}
{{- $profile := get . "profile" -}}
{{- if not (has $profile $profiles) -}}
{{-   $profile = promptChoice "What profile should be used?" $profiles -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[hooks.read-source-state.pre]
command = "bash"
args = [{{ joinPath .chezmoi.workingTree "home" ".bootstrap.sh" | quote }}, {{ $profile | quote }}]

[scriptEnv]
PATH = {{ printf "%s/.local/bin:%s/mise/shims:/opt/homebrew/bin:/usr/local/bin:%s" .chezmoi.homeDir (env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local" "share")) (env "PATH") | quote }}

[onepassword]
command = {{ joinPath .chezmoi.workingTree "home" ".onepassword.sh" | quote }}
mode = {{ if env "OP_SERVICE_ACCOUNT_TOKEN" }}"service"{{ else }}"account"{{ end }}

[data]
fullName = {{ $fullName | quote }}
email = {{ $email | quote }}
packageManager = {{ $packageManager | quote }}
profile = {{ $profile | quote }}

[git]
autoCommit = true
autoPush = true
