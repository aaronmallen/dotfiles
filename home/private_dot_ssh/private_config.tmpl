Host *
  IdentityAgent none
  AddKeysToAgent no

{{- $machine := has .chezmoi.hostname (list "aa-pc-01" "aa-pc-02" "aa-pc-03" "aa-nas-01" "aa-app-01") }}
{{ if and $machine (eq .email "hello@aaronmallen.me") -}}
Host aa-pc-01 aa-pc-02 aa-pc-03 aa-nas-01 aa-app-01
  HostName %h.local
  User aaron
  AddressFamily inet

Host aa-pc-* aa-nas-* aa-app-* 192.168.1.*
  IdentityFile ~/.ssh/id_ed25519_{{ .chezmoi.hostname }}
  IdentitiesOnly yes

{{ end -}}
Include config.local

Host ssh.aaronmallen.dev
  User git
  ProxyCommand "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/cloudflared" access ssh --hostname %h

Host *
  {{- if eq .email "hello@aaronmallen.me" }}
Host * !aa-pc-* !aa-nas-* !aa-app-* !192.168.1.*
  IdentityFile ~/.ssh/id_ed25519_hello@aaronmallen.me
  {{- else if eq .email "aallen@creditninja.com" }}
  IdentityFile ~/.ssh/id_ed25519_aallen@creditninja.com
  {{- end }}
