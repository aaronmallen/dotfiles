{{ if eq .profile "personal" -}}
{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env sh
set -eu

FSTAB="/etc/fstab"
sudo mkdir -p /mnt/truenas/documents /mnt/truenas/code
printf 'username=%s\npassword=%s\n' {{ onepasswordRead "op://Headless/ije6iarnhk53jywhcspemjq57a/username" | shellQuote }} {{ onepasswordRead "op://Headless/ije6iarnhk53jywhcspemjq57a/password" | shellQuote }} | sudo install -m 600 /dev/stdin /etc/smbcredentials-truenas

TEMP_FSTAB=$(mktemp)
trap 'rm -f "${TEMP_FSTAB}"' EXIT
sudo awk '$0 != "# TrueNAS SMB shares" && $1 !~ /^\/\/truenas\.local\/(documents|code|gitlab)$/ && $2 !~ /^\/mnt\/truenas\/(documents|code|gitlab)$/' "${FSTAB}" > "${TEMP_FSTAB}"
cat >> "${TEMP_FSTAB}" << 'EOF'
# TrueNAS SMB shares
//aa-nas-01.local/documents /mnt/truenas/documents cifs credentials=/etc/smbcredentials-truenas,uid=aaron,gid=aaron,_netdev,nofail 0 0
//aa-nas-01.local/code /mnt/truenas/code cifs credentials=/etc/smbcredentials-truenas,uid=aaron,gid=aaron,_netdev,nofail 0 0
EOF
if ! sudo cmp -s "${TEMP_FSTAB}" "${FSTAB}"; then
  sudo tee "${FSTAB}" < "${TEMP_FSTAB}" > /dev/null
  sudo systemctl daemon-reload
fi
for share in documents code; do
  if ! mountpoint -q "/mnt/truenas/${share}"; then
    sudo mount "/mnt/truenas/${share}"
  fi
done
{{ else if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env sh
set -eu

AUTO_MASTER="/etc/auto_master"
AUTO_MAP="/etc/auto_smb_truenas"
MARKER="/Volumes/nas"

SMB_PASS={{ onepasswordRead "op://Headless/ije6iarnhk53jywhcspemjq57a/password" | shellQuote }}
SMB_PASS_HEX=$(printf '%s' "${SMB_PASS}" | od -An -v -tx1 | tr -d ' \n')
if [ "${#SMB_PASS_HEX}" -gt 3800 ]; then
  echo "SMB password exceeds the security command's input limit." >&2
  exit 1
fi
printf 'add-internet-password -U -a aaron -s aa-nas-01.local -D "Network Password" -r "smb " -X "%s" /Library/Keychains/System.keychain\n' "${SMB_PASS_HEX}" | sudo security -i

  # Create the automount map file
  sudo tee "${AUTO_MAP}" > /dev/null << 'EOF'
documents -fstype=smbfs ://aaron@aa-nas-01.local/documents
code      -fstype=smbfs ://aaron@aa-nas-01.local/code
EOF
  sudo chmod 644 "${AUTO_MAP}"

  # Create the mount point (automount requires it to exist)
  sudo mkdir -p /Volumes/nas

if ! sudo grep -qF "${MARKER}" "${AUTO_MASTER}"; then
  echo "/Volumes/nas	auto_smb_truenas" | sudo tee -a "${AUTO_MASTER}" > /dev/null
fi
sudo automount -vc
{{ end -}}
{{ end -}}
