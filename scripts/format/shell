#!/usr/bin/env bash
#MISE description="Format all shell files"
#MISE alias=["fmt:sh", "fmt:shell", "format:sh"]

set -euo pipefail

shfmt -f=0 . | while IFS= read -r -d '' file; do
  IFS= read -r first_line <"$file" || true
  case "$file:$first_line" in
  *.zsh:* | *zshrc:* | *zshenv:* | *zprofile:* | *:#!*zsh*) ;;
  *) shfmt -w "$file" ;;
  esac
done
